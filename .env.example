# OpenAI-compatible RWKV text endpoint (optional).
# API mode performs live text generation, but this protocol normally does not
# expose RWKV recurrent tensors and therefore cannot create native state checkpoints.
RWKV_API_BASE_URL=http://127.0.0.1:8000/v1
RWKV_API_KEY=
RWKV_API_MODEL=rwkv7

# Direct mode requires a separately installed native runtime adapter and local
# weights. Never commit model weights or credentials to this repository.
RWKV_MODEL_PATH=
